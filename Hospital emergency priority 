#include <iostream>
using namespace std;
int main() {
    int age, heart; float oxygen, temp;
    cout << "Age: "; cin >> age;
    cout << "Temp F: "; cin >> temp;
    cout << "Oxygen %: "; cin >> oxygen;
    cout << "Heart Rate: "; cin >> heart;
    if (oxygen < 90 || heart > 130 || heart < 45) cout << "Critical";
    else if (age > 65 && temp > 102) cout << "High Priority";
    else if (oxygen >= 90 && oxygen <= 94) cout << "Moderate";
    else cout << "Normal";
    return 0;
}