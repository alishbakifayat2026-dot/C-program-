#include <iostream>
using namespace std;
int main() {
    float m[5], sum=0;
    for(int i=0;i<5;i++){ cout<<"Subject "<<i+1<<": "; cin>>m[i]; sum+=m[i]; }
    float perc = sum/5;
    bool fail = false;
    for(int i=0;i<5;i++) if(m[i]<40) fail=true;
    if(fail) cout<<"Failed";
    else {
        cout<<"Percentage: "<<perc<<"%\n";
        if(perc>=50) cout<<"Degree Qualified\n";
        if(perc>=85) cout<<"Gold Medal";
        else if(perc>=75) cout<<"Silver Medal";
        else if(perc>=65) cout<<"Merit Scholarship";
        else cout<<"Pass";
    }
    return 0;
}